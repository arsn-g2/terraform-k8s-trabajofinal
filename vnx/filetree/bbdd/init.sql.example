-- US-20 · PLANTILLA.
CREATE DATABASE IF NOT EXISTS appdb CHARACTER SET utf8mb4;
-- Acceso solo desde la subred de la VLAN (10.1.2.%). mysql_native_password
CREATE USER IF NOT EXISTS 'appuser'@'10.1.2.%'
  IDENTIFIED WITH mysql_native_password BY '__CAMBIA_ESTA_PASSWORD__';
GRANT ALL PRIVILEGES ON appdb.* TO 'appuser'@'10.1.2.%';
FLUSH PRIVILEGES;
